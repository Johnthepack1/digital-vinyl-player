[Unit]
Description=Chromium kiosk for the configured web music provider
After=graphical-session.target network-online.target setup-portal.service
Wants=network-online.target setup-portal.service

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
EnvironmentFile=-%h/digital-vinyl-player/.env
WorkingDirectory=%h/digital-vinyl-player
ExecStart=%h/digital-vinyl-player/bin/spotify_kiosk.sh
Restart=on-failure
RestartSec=2
StandardOutput=append:%h/digital-vinyl-player/logs/spotify.service.log
StandardError=append:%h/digital-vinyl-player/logs/spotify.service.log

[Install]
WantedBy=default.target
