[Unit]
Description=Python vinyl UI overlay
After=graphical-session.target spotify.service
Wants=spotify.service

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
Environment=SDL_VIDEODRIVER=x11
EnvironmentFile=-%h/digital-vinyl-player/.env
WorkingDirectory=%h/digital-vinyl-player
ExecStart=%h/digital-vinyl-player/bin/start_vinyl_ui.sh
Restart=always
RestartSec=2
StandardOutput=append:%h/digital-vinyl-player/logs/vinyl-ui.log
StandardError=append:%h/digital-vinyl-player/logs/vinyl-ui.log

[Install]
WantedBy=default.target
